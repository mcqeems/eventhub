<h1
  class='typography-display-xl'
  style='margin-bottom: var(--spacing-xl);'
>Manage Events</h1>

<div id="errorBox" class="message-box message-error" style="display: none; margin-bottom: var(--spacing-md);"></div>

<div style="margin-bottom: var(--spacing-md);">
  <button id="toggleFiltersBtn" class="typography-body-strong" style="background: none; border: none; color: var(--colors-ink); cursor: pointer; padding: 0; font-family: inherit;">[+] Search Filters</button>
</div>

<form id="panelSearchForm" method="GET" action="/panel/events" style="display: none; flex-direction: column; gap: var(--spacing-md); margin-bottom: var(--spacing-xl); padding: var(--spacing-lg); border: 1px solid var(--colors-hairline); border-radius: var(--rounded-sm); background: var(--colors-surface-soft);">
  <div style="display: flex; gap: var(--spacing-md); flex-wrap: wrap;">
    <input type="text" name="name" id="filterName" placeholder="Event Name" style="padding: 8px 12px; border: 1px solid var(--colors-hairline); border-radius: var(--rounded-sm); background: var(--colors-canvas); color: var(--colors-ink); flex: 1; font-family: inherit;" />
    <input type="date" name="date" id="filterDate" style="padding: 8px 12px; border: 1px solid var(--colors-hairline); border-radius: var(--rounded-sm); background: var(--colors-canvas); color: var(--colors-ink); flex: 1; font-family: inherit;" />
    <input type="text" name="location" id="filterLocation" placeholder="Location" style="padding: 8px 12px; border: 1px solid var(--colors-hairline); border-radius: var(--rounded-sm); background: var(--colors-canvas); color: var(--colors-ink); flex: 1; font-family: inherit;" />
  </div>
  <div style="display: flex; gap: var(--spacing-sm); justify-content: flex-end;">
    <button type="submit" class="button-primary">Search</button>
    <a href="/panel/events" class="button-secondary" style="display: flex; align-items: center; justify-content: center; text-decoration: none;">Reset Filters</a>
  </div>
</form>

<div
  style='margin-bottom: var(--spacing-xl); display: flex; justify-content: space-between; align-items: center;'
>
  <h2 class='typography-heading-md'>All Events</h2>
  <a href='/panel/events/create' class='button-primary'>Create New Event</a>
</div>

<table id='eventsTable'>
  <thead>
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Date</th>
      <th>Location</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
  </tbody>
</table>

<script src='/js/events.js'></script>