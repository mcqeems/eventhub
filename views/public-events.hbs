<h1
  class='typography-display-xl'
  style='margin-bottom: var(--spacing-sm);'
>Upcoming Events</h1>
<p class='typography-body-md' style='margin-bottom: var(--spacing-xl);'>Browse
  all upcoming events and secure your spot.</p>

<form
  id='publicSearchForm'
  method='GET'
  action='/events'
  style='margin-bottom: var(--spacing-xl); display: flex; gap: var(--spacing-md); align-items: center;'
>
  <input
    type='text'
    name='name'
    id='searchName'
    placeholder='Search event name...'
    style='padding: 8px 12px; border: 1px solid var(--colors-hairline); border-radius: var(--rounded-sm); background: var(--colors-surface-soft); color: var(--colors-ink); flex: 1; font-family: inherit;'
  />
  <button type='submit' class='button-primary'>Search</button>

</form>

<div id='publicEventsList'>
  <p class='typography-body-md' style='color: var(--colors-mute);'>Loading
    events...</p>
</div>

<script src='/js/public-events.js'></script>