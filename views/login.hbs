<h1 class="typography-display-xl" style="margin-bottom: var(--spacing-xl);">Sign In</h1>
<div id="errorBox" class="message-box message-error"></div>
<form id="loginForm">
  <div class="form-group">
    <label>Username</label>
    <input type="text" id="username" class="text-input" required />
  </div>
  <div class="form-group">
    <label>Password</label>
    <input type="password" id="password" class="text-input" required />
  </div>
  <button type="submit" class="button-primary">Sign In</button>
  <a href="/sign-up" class="button-tab" style="margin-left: 16px;">Create Account</a>
</form>

<script src="/js/login.js"></script>
