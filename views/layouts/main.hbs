<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{title}} - EventHub</title>
    <link rel='stylesheet' href='/global.css' />
  </head>
  <body>
    <header class='primary-nav'>
      <div class='primary-nav-links'>
        <a
          href='/'
          style='white-space: pre; font-size: 14px; font-weight: 700;'
        >[ EVENTHUB ]</a>
      </div>
      <div class='primary-nav-links'>
        <a href='/events'>Events</a>
        {{#if isLoggedIn}}
          <a href='/panel' class='button-primary'>Manage</a>
        {{else}}
          <a href='/sign-in' class='button-primary'>Manage</a>
        {{/if}}
      </div>
    </header>

    <main class='container section'>
      {{{body}}}
    </main>

    <footer class='footer-section'>
      <div class='container'>
        <div class='footer-bottom'>
          <p>©2026 EventHub</p>
          <p>Jakarta, Indonesia</p>
        </div>
      </div>
    </footer>
  </body>
</html>