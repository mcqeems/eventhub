<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{title}} - EventHub Panel</title>
    <link rel='stylesheet' href='/global.css' />
  </head>
  <body>
    <header class='primary-nav'>
      <div class='primary-nav-links'>
        <a
          href='/panel'
          style='white-space: pre; font-size: 14px; font-weight: 700;'
        >[ EVENTHUB PANEL ]</a>
      </div>
      <div class='primary-nav-links'>
        <a
          href='#'
          id='logoutBtn'
          class='typography-body-strong'
          style='color: var(--colors-danger);'
        >Sign Out</a>
      </div>
    </header>

    <div class='panel-layout'>
      <aside class='panel-sidebar'>
        <div
          class='typography-heading-md section-divider'
          style='margin-bottom: 16px;'
        >Menu</div>
        <a href='/panel'>[+] Dashboard</a>
        <a href='/panel/events'>[+] Events</a>
        <a href='/panel/participants'>[+] Participants</a>
      </aside>

      <main class='panel-content'>
        {{{body}}}
      </main>
    </div>

    <script src="/js/panel.js"></script>
  </body>
</html>